# syntax=docker/dockerfile:1
# ═══════════════════════════════════════════════════════════════
# Flowgent All-in-One — local development & quick testing image
# ═══════════════════════════════════════════════════════════════
# Build:  DOCKER_BUILDKIT=1 docker build -t flowgent:all-in-one -f deploy/docker/Dockerfile.all-in-one .
# Quick:  docker run --rm flowgent:all-in-one start

# ─── Stage 1: Build flowgent ─────────────────────────────────
FROM registry.cn-shenzhen.aliyuncs.com/wl4g/golang:1.26-alpine AS builder-flowgent

ENV GOPROXY=https://goproxy.cn,direct

ARG BUILD_TS=0
ARG BUILD_TAGS=x402
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=bind,source=.,target=/build \
    cd /build/pkg/cmd && CGO_ENABLED=0 go build -v -trimpath -tags "${BUILD_TAGS}" -ldflags="-s -w -X main.BuildTime=$BUILD_TS" -o /out/flowgent ./pkg/

# ─── Stage 2: Build GitHub MCP ────────────────────────────────
FROM registry.cn-shenzhen.aliyuncs.com/wl4g/golang:1.26-alpine AS builder-github-mcp

ENV GOPROXY=https://goproxy.cn,direct

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=bind,source=.,target=/build \
    cd /build/examples/security-autonomy-fixer/mcps/github && GOWORK=off CGO_ENABLED=0 go build -v -trimpath -ldflags="-s -w" -o /out/github-mcp .

# ─── Stage 3: Build SonarQube MCP ─────────────────────────────
FROM registry.cn-shenzhen.aliyuncs.com/wl4g/golang:1.26-alpine AS builder-sonarqube-mcp

ENV GOPROXY=https://goproxy.cn,direct

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=bind,source=.,target=/build \
    cd /build/examples/security-autonomy-fixer/mcps/sonarqube && GOWORK=off CGO_ENABLED=0 go build -v -trimpath -ldflags="-s -w" -o /out/sonarqube-mcp .

# ─── Stage 4: Export ──────────────────────────────────────────
FROM scratch AS export
COPY --from=builder-flowgent /out/flowgent /flowgent
COPY --from=builder-github-mcp /out/github-mcp /github-mcp
COPY --from=builder-sonarqube-mcp /out/sonarqube-mcp /sonarqube-mcp

# ─── Stage 5: Runtime ────────────────────────────────────────
FROM registry.cn-shenzhen.aliyuncs.com/wl4g/alpine:3.21

RUN apk add --no-cache ca-certificates tzdata curl jq bash python3
ENV TZ=Asia/Shanghai

COPY --from=builder-flowgent /out/flowgent /app/flowgent
COPY --from=builder-github-mcp /out/github-mcp /usr/local/bin/github-mcp
COPY --from=builder-sonarqube-mcp /out/sonarqube-mcp /usr/local/bin/sonarqube-mcp
COPY examples/ /app/examples/
COPY etc/ /app/etc/

RUN echo '' | base64 -d > /entrypoint.sh && chmod +x /entrypoint.sh

WORKDIR /app
ENTRYPOINT ["/entrypoint.sh"]
