# syntax=docker/dockerfile:1
# ═══════════════════════════════════════════════════════════════
# Flowgent All-in-One — local development & quick testing image
# ═══════════════════════════════════════════════════════════════
# Build:  DOCKER_BUILDKIT=1 docker build -t flowgent:all-in-one -f deploy/docker/Dockerfile.all-in-one .
# Quick:  docker run --rm flowgent:all-in-one start

# ─── Stage 1: Build flowgent ─────────────────────────────────
FROM registry.cn-shenzhen.aliyuncs.com/wl4g/golang:1.26-alpine AS builder-flowgent

ENV GOPROXY=https://goproxy.cn,direct

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=bind,source=.,target=/build \
    cd /build/src/cmd && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/flowgent ./src/flowgent/

# ─── Stage 2: Build MCP binaries ─────────────────────────────
FROM registry.cn-shenzhen.aliyuncs.com/wl4g/golang:1.26-alpine AS builder-mcps

ENV GOPROXY=https://goproxy.cn,direct

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=bind,source=examples/mcp-github,target=/build \
    cd /build && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/github-mcp .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=bind,source=examples/mcp-sonarqube,target=/build \
    cd /build && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sonarqube-mcp .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=bind,source=examples/mcp-sonatypeiq,target=/build \
    cd /build && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/sonatype-iq-mcp .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=bind,source=examples/mcp-nexus3,target=/build \
    cd /build && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/nexus3-mcp .

# ─── Stage 3: Export (used by `make build-all`) ──────────────
FROM scratch AS export
COPY --from=builder-flowgent /out/flowgent /flowgent
COPY --from=builder-mcps /out/ /

# ─── Stage 4: Runtime ────────────────────────────────────────
FROM registry.cn-shenzhen.aliyuncs.com/wl4g/alpine:3.21

RUN apk add --no-cache ca-certificates tzdata curl jq bash
ENV TZ=Asia/Shanghai

COPY --from=builder-flowgent /out/flowgent /app/flowgent
COPY --from=builder-mcps /out/github-mcp      /bin/github-mcp
COPY --from=builder-mcps /out/sonarqube-mcp   /bin/sonarqube-mcp
COPY --from=builder-mcps /out/sonatype-iq-mcp /bin/sonatype-iq-mcp
COPY --from=builder-mcps /out/nexus3-mcp      /bin/nexus3-mcp
COPY examples/ /app/examples/
COPY etc/ /app/etc/

RUN printf '%s\n' \
  '#!/bin/bash' \
  'set -euo pipefail' \
  'case "${1:-}" in' \
  '  ""|--help|-h|help) cat <<'"'"'HELP'"'"'' \
  'Flowgent All-in-One — Quick Start' \
  '' \
  '  docker run --rm flowgent:all-in-one [MODE]' \
  '' \
  '  Modes:' \
  '    (default)      Show this help' \
  '    start          Start server (REST :9999, mgmt :9991)' \
  '    shell          Interactive bash shell' \
  '    version        Print version' \
  '' \
  '  Subcommands: all-in-one | apiserver | a2a | controller' \
  '               jobmanager | taskmanager | sandbox | notifier | wallet' \
  '               console | version | --help' \
  '' \
  '  Bundled MCPs: /bin/{github,sonarqube,sonatype-iq,nexus3}-mcp' \
  '  Examples:     /app/examples/{agents,flows,skills}/' \
  '  Configs:      /app/etc/' \
  'HELP' \
  '    ;;' \
  '  start) exec /app/flowgent all-in-one start -c /app/etc/flowgent-dev.yaml ;;' \
  '  shell|bash|sh) exec /bin/bash ;;' \
  '  version|-v|--version) exec /app/flowgent version ;;' \
  '  *) exec /app/flowgent "$@" ;;' \
  'esac' \
  > /entrypoint.sh && chmod +x /entrypoint.sh

WORKDIR /app
ENTRYPOINT ["/entrypoint.sh"]
