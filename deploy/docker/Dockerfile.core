# syntax=docker/dockerfile:1
# ─── Stage 1: Build flowgent-core ────────────────────────────────
FROM registry.cn-shenzhen.aliyuncs.com/wl4g/golang:1.26-alpine AS builder

ARG GOPROXY
ARG GOFLAGS
ARG GOMAXPROCS
ARG BUILD_TS=0
ARG BUILD_TAGS=
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=bind,source=.,target=/build \
    set -e; \
    if [ -n "${GOFLAGS}" ]; then export GOFLAGS; fi; \
    if [ -n "${GOMAXPROCS}" ]; then export GOMAXPROCS; fi; \
    cd /build/pkg/cmd; \
    CGO_ENABLED=0 go build -v -trimpath -tags "${BUILD_TAGS}" -ldflags="-s -w -X main.BuildTime=$BUILD_TS" -o /out/flowgent ./pkg/

# ─── Stage 2: Export ────────────────────────────────────────────
FROM scratch AS export
COPY --from=builder /out/ /

# ─── Stage 3: Runtime ───────────────────────────────────────────
FROM registry.cn-shenzhen.aliyuncs.com/wl4g/alpine:3.21

RUN apk add --no-cache ca-certificates tzdata curl jq bash git python3
ENV TZ=Asia/Shanghai

COPY --from=builder /out/flowgent /app/flowgent
COPY etc/ /app/etc/

ENTRYPOINT ["/app/flowgent"]
CMD ["--help"]
