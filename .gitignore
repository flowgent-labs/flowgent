# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
/flowgent
/flowgent-*
/server
/core

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# vendor/

# env file
.env

# Data file
.flowgent

# Editor/IDE
.idea/
.vscode/
ca-certificates.crt
__pycache__/

# E2E verification reports (archived directories are gitignored)
use-cases/*/e2e/reports/*
use-cases/*/e2e/.last_*
use-cases/*/e2e/.venv/
